<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_otp_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/sign_in_otp_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_enter_text"
            android:textColor="@color/white"
            android:textSize="24sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="125dp"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/introduction_otp_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Отправить  код повторно через 23 с"
            android:textColor="#686868"
            android:textSize="12sp"
            android:layout_marginHorizontal="118dp"
            app:layout_constraintTop_toBottomOf="@id/sign_in_otp_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <EditText
            android:id="@+id/number_otp_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/introduction_otp_text"
            android:layout_marginTop="22dp"
            android:layout_marginHorizontal="80dp"
            android:inputType="phone"
            android:digits="0123456789+() -"
            android:textColor="@color/white"
            android:background="@drawable/edit_text_backgroud"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/proceed_otp_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/number_otp_input"
            android:layout_marginTop="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Отправить"
            android:textColor="@color/white"
            android:paddingVertical="15dp"
            android:paddingHorizontal="62dp"
            android:background="@drawable/button_background"
            android:backgroundTint="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Неверный номер?"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="@+id/proceed_otp_button"
            app:layout_constraintStart_toStartOf="@+id/proceed_otp_button"
            app:layout_constraintTop_toBottomOf="@+id/proceed_otp_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>