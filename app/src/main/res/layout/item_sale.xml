<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_item_sale_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_item_sale_container"
        android:layout_width="wrap_content"
        android:layout_height="240dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/item_sale_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            tools:src="@drawable/img_roll" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        android:textStyle="bold"
        android:text="@string/home_roll_text"
        android:textColor="@color/home_sale_text_color"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@id/home_roll_order_text"
        app:layout_constraintStart_toStartOf="@id/home_roll_order_text"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/home_roll_order_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        android:text="При заказе от 1000 ₽"
        android:textColor="@color/home_sale_text_color"
        app:layout_constraintBottom_toBottomOf="@+id/card_item_sale_container"
        app:layout_constraintStart_toStartOf="@+id/card_item_sale_container"
        android:layout_marginBottom="26dp"
        android:layout_marginStart="26dp" />

</androidx.constraintlayout.widget.ConstraintLayout>